rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sensor readings — ESP32 devices write via email/password auth
    match /raw/{doc} {
      allow create: if request.auth.token.firebase.sign_in_provider == 'password'
                    && request.resource.data.device_id is string;
      allow read:   if request.auth != null;
      allow update, delete: if false;
    }

    // Rollup aggregates — written by Admin SDK (bypasses rules), read by dashboard
    match /agg_30m/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }
    match /agg_1h/{doc} {
      allow read:  if request.auth != null;
      allow write: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
